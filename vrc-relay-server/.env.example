# .envは最小限方針: DB接続・秘密鍵・外部サービス認証情報のみをここに置く。
# それ以外の運用設定(ログ保持日数、キーローテーション等)はDB(app_settings)＋管理パネルWebUIで変更する。

# --- DB接続 ---
DATABASE_URL=mysql+aiomysql://vrc_relay:change_me@mysql:3306/vrc_relay

# --- JWT ---
JWT_SECRET_KEY=change_me_to_a_random_64_char_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_SETUP_TOKEN_EXPIRE_MINUTES=2880

# --- 初回管理者アカウント自動作成 ---
# 起動時にこのユーザー名のadminが存在しなければ自動作成する。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# --- Webサーバーのポート ---
# ホスティング環境(Pterodactyl等)ごとに割り当てが変わるため固定しない。
APP_PORT=8000

# --- MediaMTX HTTP API(公開サーバー側) ---
MEDIAMTX_API_BASE_URL=http://mediamtx:9997
# /internal/mediamtx/auth を叩く際にMediaMTX側から付与される共有シークレット(任意・推奨)
MEDIAMTX_WEBHOOK_SHARED_SECRET=change_me

# --- 公開URL(VRC再生用URL組み立てに使用) ---
# ストリーム用(RTMP/RTSPS)は直接ポート公開するドメイン。Web用ドメインとは別に用意する。
# 例: vrc-lr.chok.ooo
PUBLIC_RTSPS_HOST=your-stream-domain.example.com
PUBLIC_RTSPS_PORT=8322
PUBLIC_RTMP_HOST=your-stream-domain.example.com
PUBLIC_RTMP_PORT=1935

# --- Discord Bot(承認通知DM) ---
DISCORD_BOT_TOKEN=

# --- Web(パスワード設定リンク組み立てに使用) ---
# Cloudflare Tunnel等で公開しているWeb管理パネルのドメイン。例: vrc-lr.choko1229.net
PUBLIC_WEB_BASE_URL=https://your-web-domain.example.com

# --- Cloudflare Tunnel(Web管理パネル/APIの公開に使用、ポート開放不要) ---
# Cloudflare Zero Trustダッシュボードで作成したトンネルのトークン。
# トンネルのpublic hostname(例: vrc-lr.choko1229.net)のServiceは
# http://app:${APP_PORT} を指すよう設定すること。
CLOUDFLARE_TUNNEL_TOKEN=
